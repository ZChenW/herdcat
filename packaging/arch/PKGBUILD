pkgname=bongocat-agent-git
pkgver=2.0.2.r0.g0000000
pkgrel=1
pkgdesc='Wayland Bongo Cat with session-aware agent status and persistent dragging'
arch=('x86_64' 'aarch64')
url='https://github.com/ZChenW/wayland-bongocat'
license=('MIT')
depends=('glibc' 'wayland')
makedepends=('git' 'gcc' 'make')
provides=('bongocat')
conflicts=('bongocat')
source=('wayland-bongocat::git+https://github.com/ZChenW/wayland-bongocat.git#branch=feature/agent-state')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/wayland-bongocat"
  printf '2.0.2.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/wayland-bongocat"
  make release
}

check() {
  cd "$srcdir/wayland-bongocat"
  make test
}

package() {
  cd "$srcdir/wayland-bongocat"
  make BUILD_TYPE=release PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
