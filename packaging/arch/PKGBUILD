pkgname=herdcat-git
pkgver=0.3.0.r0.g0000000
pkgrel=1
pkgdesc='Wayland desktop cat that holds up a sign for every coding agent session'
arch=('x86_64' 'aarch64')
url='https://github.com/ZChenW/herdcat'
license=('MIT')
depends=('glibc' 'wayland' 'freetype2' 'fontconfig')
optdepends=('python: herdcat setup')
makedepends=('git' 'gcc' 'make' 'pkgconf')
provides=('herdcat')
conflicts=('herdcat')
source=('herdcat::git+https://github.com/ZChenW/herdcat.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/herdcat"
  printf '0.3.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/herdcat"
  make PREFIX=/usr release
}

check() {
  cd "$srcdir/herdcat"
  make test
}

package() {
  cd "$srcdir/herdcat"
  # Includes the user service, shell completions and share/herdcat setup helper.
  make BUILD_TYPE=release PREFIX=/usr INPUT_HELPER_SETGID=0 DESTDIR="$pkgdir" install
  chown root:input "$pkgdir/usr/lib/herdcat/herdcat-input"
  chmod 2755 "$pkgdir/usr/lib/herdcat/herdcat-input"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
