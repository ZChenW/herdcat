# ═══════════════════════════════════════════════════════════════════════════════
# BONGO CAT CONFIG - Default Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Save this file to: ~/.config/herdcat/herdcat.conf
# Run with: herdcat --watch-config
# ═══════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ APPEARANCE                                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘

# Cat size and position
cat_height=110
cat_align=center
cat_x_offset=0
cat_y_offset=0
# Left-button dragging; 0 restores complete click-through.
# Saved positions override cat_align/cat_x_offset until --reset-position.
cat_draggable=1

# Deprecated: no-op with SVG rendering (antialiasing is always enabled)
# enable_antialiasing=1

# Flip the cat
mirror_x=0
mirror_y=0

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ OVERLAY BAR                                                                 │
# └─────────────────────────────────────────────────────────────────────────────┘

# Bar dimensions
overlay_height=120

# Background: 0=transparent, 255=opaque
overlay_opacity=0

# Position: top, bottom
overlay_position=bottom

# Layer: background, bottom, top, or overlay (always visible)
layer=top

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ INPUT DEVICES                                                               │
# └─────────────────────────────────────────────────────────────────────────────┘

# Find your device with: herdcat-find-devices
# Add multiple lines for multiple keyboards
# Leave selectors unset to select accessible keyboard-capable devices.
# keyboard_device=/dev/input/by-id/YOUR-KEYBOARD-event-kbd

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ MULTI-MONITOR (optional)                                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# Leave commented to auto-detect
# Find monitor names with: wlr-randr or hyprctl monitors
# monitor=eDP-1
# monitor=eDP-1,HDMI-A-1

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ ANIMATION                                                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

fps=60
idle_frame=0
keypress_duration=100

# Hand mapping: 0=random hands, 1=left keys→left hand, right keys→right hand
enable_hand_mapping=1

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ SLEEP MODE (optional)                                                       │
# └─────────────────────────────────────────────────────────────────────────────┘

# Hide after N seconds of no keyboard activity (0=disabled)
# When triggered, displays a dedicated sleeping animation frame
idle_sleep_timeout=0

# Seconds a seen completion stays visible (or every done with sign_done=timeout)
# (0 = stay until another event for that session; valid range 0..3600)
agent_done_timeout=5

# Inactive working sessions return to idle after this many seconds.
# Waiting expires only without a working process watch. 0 disables stale expiry.
# Global setting, valid range 0..86400 seconds.
agent_stale_timeout=600

# Watch newly appended Claude/Codex records for interruptions/errors.
# Global boolean, immediately reloadable; no contents are logged or saved.
agent_interrupt_detect=1

# Scheduled sleep (requires enable_scheduled_sleep=1)
enable_scheduled_sleep=0
sleep_begin=22:00
sleep_end=06:00

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ FULLSCREEN                                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘

# Keep overlay visible even when a fullscreen window is detected (0=hide, 1=show)
# disable_fullscreen_hide=0

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ HOTPLUG                                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# How often to rescan for new input devices, in seconds (0=scan once at startup)
# hotplug_scan_interval=30

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ TEST ANIMATION                                                              │
# └─────────────────────────────────────────────────────────────────────────────┘

# Duration of each test animation frame in milliseconds
# test_animation_duration=200
# Interval between test animation cycles in seconds (0=disabled)
# test_animation_interval=0

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ DEBUG                                                                       │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# Debug mode reports runtime activity; keycodes are never logged.
#
# Enable debug logging (0=disabled, 1=enabled)
enable_debug=0

# Per-monitor appearance (input and timing remain global).
# Sections do not select monitors; set monitor=NAME1,NAME2 above.
# [monitor:HDMI-A-1]
# cat_height=60
# cat_align=right
# mirror_x=1
# disable_fullscreen_hide=1
# [global]

# Session signs (global settings; reload with -w or --reload).
sign_style=fan           # fan | post | off (off uses whole-cat agent artwork)
sign_max=5               # 1..5 displayed sessions
sign_idle=hover          # hover | always | never
sign_font=               # Fontconfig family; empty selects system sans-serif
sign_font_size=13        # 10..20; metadata and desk text scale proportionally
sign_animations=full     # full | reduced (transitions only) | off
# Experimental Hyprland/Sway focus backends: unverified on real compositors.
# Existing Hyprland fullscreen detection is independent of this setting.
compositor_experimental=0
sign_theme=light        # light | auto | dark (auto follows XDG portal)
sign_language=auto       # auto (LC_MESSAGES, then LANG) | en | zh
sign_done=sticky         # sticky (unread stays up) | timeout
sign_typing_desk=1        # 0 disables the focused-session typing desk

# ─── What a sign is called ─────────────────────────────────────────────────
# A session has two names: its project (the directory) and its title (what
# the agent calls the conversation, once it has one). Uncomment a line to
# change it; saving the file applies it at once.

# Which of the two is the main, bold name.
#   project  always the project
#   title    the title when there is one, otherwise the project
sign_name=project
# sign_name=title

# Where the other one goes on the fan's nameplate (hover a sign to see it).
# Default: project followed by title. An absent/equal title is omitted.
# Post boards show the extra after the main name for all choices except off;
# the extra is truncated to fit, or omitted below 24 logical pixels.
# The typing desk shows only the main name.
#   off      not shown                    herdcat  Claude · Working
#   inline   right after the main name    herdcat  Fix login · Claude · Working
#   end      after the state              herdcat  Claude · Working · Fix login
#   above    on a line of its own above
#   below    on a line of its own below
sign_name_extra=inline
# sign_name_extra=below

# Longest title shown, in characters. 0 shows all of it.
sign_title_length=16

# For full control, write the nameplate yourself. This overrides
# sign_name_extra on fan nameplates only. Pieces you can use:
#   {name}     the main name chosen by sign_name
#   {project}  the directory name        {title}  the session title
#   {agent}    Claude, Codex, ...        {state}  Working 3 min, Needs approval, ...
#   **...**    bold                      \n      start a second line (one at most)
# A piece that is empty disappears together with its " · " separator.
# A template with a mistake is ignored; `herdcat --check-config` says where.
# sign_nameplate=**{name}**  {agent} · {state}
# sign_nameplate=**{name}**  {agent} · {state}\n{title}
# sign_nameplate={agent} · **{title}**\n{project} · {state}
